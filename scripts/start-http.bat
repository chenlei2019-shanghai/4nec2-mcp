@echo off
rem 4NEC2 MCP Server - HTTP transport, endpoint http://127.0.0.1:8765/mcp
rem Generated by scripts\install.ps1 - re-run install.ps1 to regenerate.
setlocal
set "NEC4NEC_DIR=C:\4nec2"
set "PY=C:\4nec2-mcp-server\.venv\Scripts\python.exe"
set "SERVER=C:\4nec2-mcp-server\mcp_4nec2_server.py"
if not defined MCP_HTTP_HOST set "MCP_HTTP_HOST=127.0.0.1"
if not defined MCP_HTTP_PORT set "MCP_HTTP_PORT=8765"
if not exist "%PY%" (
  echo [ERROR] venv python not found: %PY%
  echo         run scripts\install.ps1 first.
  exit /b 1
)
if not exist "%SERVER%" (
  echo [ERROR] server script not found: %SERVER%
  exit /b 1
)

"%PY%" "%SERVER%" --4nec2-dir "%NEC4NEC_DIR%" --transport streamable-http --host %MCP_HTTP_HOST% --port %MCP_HTTP_PORT% %*
endlocal
