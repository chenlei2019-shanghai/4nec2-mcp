@echo off
rem 4NEC2 MCP Server - stdio transport (for DSH / MCP clients)
rem Generated by scripts\install.ps1 - re-run install.ps1 to regenerate.
setlocal
set "NEC4NEC_DIR=C:\4nec2"
set "PY=C:\4nec2-mcp-server\.venv\Scripts\python.exe"
set "SERVER=C:\4nec2-mcp-server\mcp_4nec2_server.py"
if not exist "%PY%" (
  echo [ERROR] venv python not found: %PY%
  echo         run scripts\install.ps1 first.
  exit /b 1
)
if not exist "%SERVER%" (
  echo [ERROR] server script not found: %SERVER%
  exit /b 1
)

"%PY%" "%SERVER%" --4nec2-dir "%NEC4NEC_DIR%" --transport stdio %*
endlocal
